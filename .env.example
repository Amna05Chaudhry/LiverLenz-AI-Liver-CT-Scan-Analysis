# LLM for the report impression and chat (OpenAI-compatible API).
# Leave LLM_API_KEY empty to run fully offline with templated answers.
# Groq (free key at https://console.groq.com/keys) - default
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.2  (no key needed)

# Optional: use a different model file (.onnx, or .h5 if TensorFlow is installed)
# LIVERLENZ_MODEL=models/liver_segmentation_model.onnx
